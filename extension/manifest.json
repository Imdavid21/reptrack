{
  "manifest_version": 3,
  "name": "RepTrack",
  "version": "0.2.0",
  "description": "Quick food and water logging for RepTrack.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://reptrack.fitness/*",
    "https://*.reptrack.fitness/*",
    "https://kfifgbqkykyvnrirxwze.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RepTrack",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://reptrack.fitness/*", "https://*.reptrack.fitness/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
