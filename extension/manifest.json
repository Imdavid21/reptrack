{
  "manifest_version": 3,
  "name": "RepTrack Quick Log",
  "version": "0.1.0",
  "description": "Log food and water to RepTrack without leaving the page.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://reptrack.fitness/*",
    "https://*.reptrack.fitness/*",
    "https://kfifgbqkykyvnrirxwze.supabase.co/*"
  ],
  "action": {
    "default_title": "RepTrack Quick Log",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://reptrack.fitness/*", "https://*.reptrack.fitness/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
